<script>
  let currentChamber = 'senado';
  let votosDiputados = 49;
  let riveraConcedido = false;
  let canelonesAplacado = false;

  // Render Senators Hemicircle (31 seats: 16 FA, 9 PN, 4 PC, 1 CA, 1 VP Presidencia)
  function renderSenado() {
    const seats = [
      ...Array(16).fill('#1e40af'), // FA
      ...Array(9).fill('#38bdf8'),  // PN
      ...Array(4).fill('#dc2626'),  // PC
      ...Array(1).fill('#eab308'),  // CA
      '#e87532'                    // Presidencia Vicepresidenta
    ];
    
    // Draw 2 concentric radial tiers
    let circlesSvg = '';
    const cx = 150;
    const cy = 135;
    
    // Inner tier (12 seats)
    const r1 = 65;
    const totalTier1 = 13;
    for (let i = 0; i < totalTier1; i++) {
      const angle = Math.PI - (i / (totalTier1 - 1)) * Math.PI;
      const x = cx + r1 * Math.cos(angle);
      const y = cy - r1 * Math.sin(angle);
      const color = seats[i] || '#313637';
      circlesSvg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="6" fill="${color}" stroke="#171c1d" stroke-width="1.5" class="transition-transform hover:scale-125 cursor-pointer"/>`;
    }

    // Outer tier (18 seats)
    const r2 = 98;
    const totalTier2 = 18;
    for (let i = 0; i < totalTier2; i++) {
      const idx = totalTier1 + i;
      const angle = Math.PI - (i / (totalTier2 - 1)) * Math.PI;
      const x = cx + r2 * Math.cos(angle);
      const y = cy - r2 * Math.sin(angle);
      const color = seats[idx] || '#313637';
      circlesSvg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="6" fill="${color}" stroke="#171c1d" stroke-width="1.5" class="transition-transform hover:scale-125 cursor-pointer"/>`;
    }

    // Dais center seat
    circlesSvg += `<circle cx="150" cy="130" r="7" fill="#ffb691" stroke="#511e00" stroke-width="2"/>`;

    return `
      <svg viewBox="0 0 300 150" class="w-full max-w-[290px] h-auto drop-shadow-md">
        <path d="M 40 135 A 110 110 0 0 1 260 135" fill="none" stroke="#262b2c" stroke-width="2" stroke-dasharray="3,3"/>
        ${circlesSvg}
      </svg>
    `;
  }

  // Render Deputies Hemicircle (99 seats: 48 FA, 31 PN, 13 PC, 5 CA, 1 PI + 1 extra)
  function renderDiputados() {
    const seats = [
      ...Array(48).fill('#1e40af'), // FA
      ...Array(31).fill('#38bdf8'), // PN
      ...Array(13).fill('#dc2626'), // PC
      ...Array(5).fill('#eab308'),  // CA
      ...Array(1).fill('#a855f7'),  // PI
      '#7b9c8e'                    // Independiente/Disidente
    ];

    let circlesSvg = '';
    const cx = 150;
    const cy = 138;
    const tiers = [
      { r: 48, count: 18 },
      { r: 72, count: 26 },
      { r: 96, count: 32 },
      { r: 118, count: 23 }
    ];

    let seatPointer = 0;
    tiers.forEach(tier => {
      for (let i = 0; i < tier.count; i++) {
        const angle = Math.PI - (i / (tier.count - 1)) * Math.PI;
        const x = cx + tier.r * Math.cos(angle);
        const y = cy - tier.r * Math.sin(angle);
        const color = seats[seatPointer] || '#dec1b4';
        seatPointer++;
        circlesSvg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="4.2" fill="${color}" stroke="#171c1d" stroke-width="1"/>`;
      }
    });

    return `
      <svg viewBox="0 0 300 150" class="w-full max-w-[290px] h-auto drop-shadow-md">
        <path d="M 30 138 A 120 120 0 0 1 270 138" fill="none" stroke="#262b2c" stroke-width="1.5" stroke-dasharray="2,2"/>
        ${circlesSvg}
      </svg>
    `;
  }

  function switchChamber(chamber) {
    currentChamber = chamber;
    const tabSen = document.getElementById('tab-senado');
    const tabDip = document.getElementById('tab-diputados');
    const title = document.getElementById('chamber-title');
    const sub = document.getElementById('chamber-subtitle');
    const quorum = document.getElementById('quorum-badge');
    const dais = document.getElementById('dais-label');
    const mount = document.getElementById('hemicircle-mount');

    const countFa = document.getElementById('count-fa');
    const countPn = document.getElementById('count-pn');
    const countPc = document.getElementById('count-pc');
    const countCa = document.getElementById('count-ca');
    const countPi = document.getElementById('count-pi');
    const countMaj = document.getElementById('count-maj');

    if (chamber === 'senado') {
      tabSen.className = 'flex-1 py-2 px-space-sm rounded-lg font-label-md text-label-md transition-all flex items-center justify-center gap-1.5 bg-primary-container text-on-primary-container shadow-sm';
      tabDip.className = 'flex-1 py-2 px-space-sm rounded-lg font-label-md text-label-md transition-all flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface';
      title.innerText = 'Cámara de Senadores';
      sub.innerText = 'Palacio Legislativo • Sala de Sesiones';
      quorum.innerText = 'Quórum: 31/31';
      dais.innerText = 'Presidencia: Vicepresidenta de la República (Voto Dirimente)';
      mount.innerHTML = renderSenado();

      countFa.innerText = '16 bancas';
      countPn.innerText = '9 bancas';
      countPc.innerText = '4 bancas';
      countCa.innerText = '1 banca';
      countPi.innerText = '0 bancas';
      countMaj.innerText = '16 votos';
    } else {
      tabDip.className = 'flex-1 py-2 px-space-sm rounded-lg font-label-md text-label-md transition-all flex items-center justify-center gap-1.5 bg-primary-container text-on-primary-container shadow-sm';
      tabSen.className = 'flex-1 py-2 px-space-sm rounded-lg font-label-md text-label-md transition-all flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface';
      title.innerText = 'Cámara de Representantes';
      sub.innerText = 'Palacio Legislativo • Sala de Diputados';
      quorum.innerText = 'Quórum: 99/99';
      dais.innerText = 'Mesa de Presidencia: Presidente de la Cámara de Representantes';
      mount.innerHTML = renderDiputados();

      countFa.innerText = '48 bancas';
      countPn.innerText = '31 bancas';
      countPc.innerText = '13 bancas';
      countCa.innerText = '5 bancas';
      countPi.innerText = '1 banca';
      countMaj.innerText = '50 votos';
    }
  }

  function negotiateRivera() {
    if (riveraConcedido) return;
    riveraConcedido = true;
    votosDiputados = 50;

    const btn = document.getElementById('btn-conceder-rivera');
    const tag = document.getElementById('rivera-status-tag');
    const counter = document.getElementById('votos-counter');
    const alert = document.getElementById('status-alerta');
    const progress = document.getElementById('vote-progress-fill');

    btn.classList.remove('bg-primary-container', 'text-on-primary-container');
    btn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');
    btn.innerHTML = `<span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px]">verified</span>Fondo Acordado • Voto Afirmativo Asegurado</span>`;
    
    tag.className = 'font-label-sm text-[10px] px-2 py-0.5 rounded bg-tertiary-container text-on-tertiary-container uppercase shrink-0 font-bold';
    tag.innerText = 'VOTO ASEGURADO';

    counter.innerText = '50 / 50';
    counter.className = 'font-label-sm text-label-sm text-tertiary font-bold';
    
    alert.innerText = '¡Mayoría Absoluta Alcanzada!';
    alert.className = 'font-label-sm text-[10px] text-tertiary font-semibold uppercase';

    progress.style.width = '50.5%';
    progress.classList.remove('bg-primary-container');
    progress.classList.add('bg-tertiary');

    showToast('¡Voto 50 asegurado! Ley lista para sanción en Representantes (-15 CP)');
  }

  function appeaseCanelones() {
    if (canelonesAplacado) return;
    canelonesAplacado = true;

    const btn = document.getElementById('btn-aplaced-canelones');
    const tag = document.getElementById('canelones-status-tag');

    btn.className = 'w-full py-2.5 px-space-md rounded-lg bg-surface-container text-tertiary font-label-md text-label-md font-medium flex items-center justify-between pointer-events-none opacity-80';
    btn.innerHTML = `<span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px]">done_all</span>Subsidio Comprometido • Interpelación Declinada</span>`;
    
    tag.className = 'font-label-sm text-[10px] px-2 py-0.5 rounded bg-surface-container-highest text-tertiary uppercase shrink-0';
    tag.innerText = 'Neutralizado';

    showToast('Pacto con ala sindical sellado: Interpelación desactivada (-30 CP)');
  }

  function applyTactic(type, cost) {
    if (type === 'gabinete') {
      showToast('Oferta ministerial enviada a bancada independiente (-30 CP)');
    } else if (type === 'articulado') {
      showToast('Texto reformulado en Comisión de Hacienda (-15 CP)');
    } else {
      showToast('Convocatoria de urgencia a directiva partidaria realizada');
    }
  }

  function showToast(text) {
    const toast = document.getElementById('toast-negotiation');
    const toastText = document.getElementById('toast-text');
    toastText.innerText = text;
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 4000);
  }

  function dismissToast() {
    document.getElementById('toast-negotiation').classList.add('hidden');
  }

  // Initial draw
  switchChamber('senado');
