<script>
  // Dynamic Game Audio State
  let isMuted = false;
  function toggleAudio() {
    isMuted = !isMuted;
    const icon = document.getElementById('audio-icon');
    const label = document.getElementById('audio-label');
    const eq = document.getElementById('sound-eq');
    if (isMuted) {
      icon.innerText = 'volume_off';
      icon.classList.remove('text-primary');
      icon.classList.add('text-secondary');
      label.innerText = 'BSO MUTE';
      if (eq) eq.classList.add('opacity-20');
    } else {
      icon.innerText = 'volume_up';
      icon.classList.add('text-primary');
      icon.classList.remove('text-secondary');
      label.innerText = 'BSO ON';
      if (eq) eq.classList.remove('opacity-20');
    }
  }

  function setDifficulty(mode) {
    const btnConst = document.getElementById('diff-const');
    const btnReal = document.getElementById('diff-real');
    const desc = document.getElementById('diff-desc');

    if (mode === 'const') {
      btnConst.className = 'flex-1 py-2 px-2 rounded-lg font-label-md text-label-md transition-all bg-primary-container text-on-primary-container font-bold flex items-center justify-center gap-1.5 shadow-md border-t border-white/25 active:scale-95';
      btnReal.className = 'flex-1 py-2 px-2 rounded-lg font-label-md text-label-md transition-all text-secondary hover:text-on-surface flex items-center justify-center gap-1.5 hover:bg-surface-container active:scale-95';
      desc.innerText = 'Equilibrio estricto de mayorías parlamentarias, interpelaciones senatoriales y pactos de coalición republicana.';
    } else {
      btnReal.className = 'flex-1 py-2 px-2 rounded-lg font-label-md text-label-md transition-all bg-error-container text-on-error-container font-bold flex items-center justify-center gap-1.5 shadow-md border-t border-white/20 active:scale-95';
      btnConst.className = 'flex-1 py-2 px-2 rounded-lg font-label-md text-label-md transition-all text-secondary hover:text-on-surface flex items-center justify-center gap-1.5 hover:bg-surface-container active:scale-95';
      desc.innerText = 'Huelgas generales, presiones de cámaras agropecuarias, filtraciones mediáticas y crisis cambiaria sin tregua.';
    }
  }

  // Atmospheric Video Game Particles Canvas
  (function initAtmosphericParticles() {
    const canvas = document.getElementById('particle-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let width = canvas.width = window.innerWidth;
    let height = canvas.height = window.innerHeight;

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const particles = [];
    const count = 38;

    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.8 + 0.5,
        dx: (Math.random() - 0.5) * 0.4,
        dy: -Math.random() * 0.45 - 0.15,
        alpha: Math.random() * 0.7 + 0.2,
        amber: Math.random() > 0.4
      });
    }

    function render() {
      ctx.clearRect(0, 0, width, height);
      for (let p of particles) {
        p.x += p.dx;
        p.y += p.dy;
        if (p.y < 0) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.amber ? `rgba(232, 117, 50, ${p.alpha * 0.6})` : `rgba(255, 230, 200, ${p.alpha * 0.4})`;
        ctx.fill();
      }
      requestAnimationFrame(render);
    }
    render();
  })();
</script></main></body></html>