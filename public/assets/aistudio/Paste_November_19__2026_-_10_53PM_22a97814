  function selectDepartment(key) {
    if (!DEPARTAMENTOS[key]) return;
    currentSelectedKey = key;
    const data = DEPARTAMENTOS[key];

    // Reset all vector outlines
    Object.keys(DEPARTAMENTOS).forEach(k => {
      const el = document.getElementById(`dept-${k}`);
      if (el) {
        el.setAttribute('stroke', '#0a0f10');
        el.setAttribute('stroke-width', '1.8');
      }
    });

    // Highlight selected vector
    const selectedEl = document.getElementById(`dept-${key}`);
    if (selectedEl) {
      selectedEl.setAttribute('stroke', '#ffb691');
      selectedEl.setAttribute('stroke-width', '3');
    }

    // Update HUD & Bottom Sheet
    document.getElementById('hover-dept-name').innerText = data.name.charAt(0) + data.name.slice(1).toLowerCase();
    document.getElementById('sheet-dept-name').innerText = data.name;
    document.getElementById('sheet-dept-meta').innerText = data.meta;
    document.getElementById('sheet-dept-gov').innerText = data.gov;
    document.getElementById('sheet-dept-econ').innerText = data.econ;
    document.getElementById('sheet-dept-empleo').innerText = data.empleo;

    // Badges & Status
    const badge = document.getElementById('badge-partido');
    badge.innerText = data.partyName.toUpperCase();
    badge.style.backgroundColor = `${data.partyColor}26`;
    badge.style.color = data.partyBadgeText;

    const tag = document.getElementById('sheet-status-tag');
    tag.innerText = data.status;

    // Voting intent meters
    document.getElementById('bar-fa').style.width = `${data.fa}%`;
    document.getElementById('bar-cr').style.width = `${data.cr}%`;
    document.getElementById('bar-ind').style.width = `${data.ind}%`;

    document.getElementById('val-fa').innerText = `FA: ${data.fa}%`;
    document.getElementById('val-cr').innerText = `Coalición: ${data.cr}%`;
    document.getElementById('val-ind').innerText = `Indecisos: ${data.ind}%`;
  }

  function switchMapMode(mode) {
    currentMapMode = mode;
    const modes = ['poder', 'voto', 'inversion', 'empleo'];

    // Update tab pills style
    modes.forEach(m => {
      const btn = document.getElementById(`btn-mode-${m}`);
      if (m === mode) {
        btn.className = "mode-tab shrink-0 px-3 py-1.5 rounded-full bg-primary-container text-on-primary-container font-label-sm text-label-sm font-semibold shadow-md flex items-center gap-1.5 transition-all";
      } else {
        btn.className = "mode-tab shrink-0 px-3 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm hover:text-on-surface transition-all flex items-center gap-1.5";
      }
    });

    const labelEl = document.getElementById('map-mode-label');

    // Dynamically restyle vector fills according to tactical layer
    Object.keys(DEPARTAMENTOS).forEach(k => {
      const el = document.getElementById(`dept-${k}`);
      if (!el) return;
      const dept = DEPARTAMENTOS[k];

      if (mode === 'poder') {
        labelEl.innerText = "INTENDENCIAS 2025-2030";
        el.setAttribute('fill', dept.partyColor);
        el.setAttribute('fill-opacity', k === currentSelectedKey ? '0.98' : '0.88');
      } else if (mode === 'voto') {
        labelEl.innerText = "PROYECCIÓN BALOTAJE 2029";
        // Gradient color scale FA vs Coalición
        el.setAttribute('fill', dept.fa > dept.cr ? '#D9383A' : '#4285F4');
        el.setAttribute('fill-opacity', Math.abs(dept.fa - dept.cr) > 15 ? '0.95' : '0.65');
      } else if (mode === 'inversion') {
        labelEl.innerText = "INVERSIÓN OBRAS UYU (2029)";
        const heavyInvest = ['canelones', 'montevideo', 'maldonado', 'durazno', 'tacuarembo'];
        el.setAttribute('fill', heavyInvest.includes(k) ? '#accebf' : '#313637');
        el.setAttribute('fill-opacity', '0.9');
      } else if (mode === 'empleo') {
        labelEl.innerText = "DESEMPLEO & TENSIÓN LABORAL";
        const highUnemp = ['salto', 'artigas', 'paysandu', 'rionegro'];
        el.setAttribute('fill', highUnemp.includes(k) ? '#e87532' : '#262b2c');
        el.setAttribute('fill-opacity', '0.9');
      }
    });
  }

  function executeAction(type, cost, msg) {
    const toast = document.getElementById('tactical-toast');
    const toastMsg = document.getElementById('tactical-toast-msg');
    toastMsg.innerText = `${msg} en ${DEPARTAMENTOS[currentSelectedKey].name}.`;
    toast.classList.remove('hidden');
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');

    setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 2400);
  }
